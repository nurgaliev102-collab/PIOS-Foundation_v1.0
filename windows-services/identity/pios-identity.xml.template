<service>
  <id>pios-identity</id>
  <name>PIOS Identity</name>
  <description>PIOS identity backend module (Spring Boot 3.3.4), managed by WinSW. T-2 of ENGINEERING_EXECUTION_PLAN_SPRINT_1_PLATFORM_OPERATIONS_MVP.md; grounded in ADR-046 Decision 2 and ADR-049 Decisions 1-2.</description>
  <executable>C:\Program Files\Eclipse Adoptium\jdk-21.0.12.8-hotspot\bin\java.exe</executable>
  <arguments>-jar "build\libs\identity-0.1.0-SNAPSHOT.jar"</arguments>
  <workingdirectory>C:\Projects\PIOS-Foundation_v1.0\backend\identity</workingdirectory>
  <!-- See LOG_DIRECTORY_POLICY.md: working directory must match bootRun's
       own default so the T-1 log path keeps resolving correctly. -->
  <env name="PIOS_PILOT_FRONTEND_ORIGIN" value="https://piosapp.ru"/>
  <env name="PIOS_OWNER_USERNAME" value="__PIOS_OWNER_USERNAME__"/>
  <env name="PIOS_OWNER_PASSWORD_HASH" value="__PIOS_OWNER_PASSWORD_HASH__"/>
  <env name="PIOS_OWNER_PASSWORD_SALT" value="__PIOS_OWNER_PASSWORD_SALT__"/>
  <env name="PIOS_SMS_LOGIN" value="__PIOS_SMS_LOGIN__"/>
  <env name="PIOS_SMS_API_KEY" value="__PIOS_SMS_API_KEY__"/>
  <env name="PIOS_SMS_SENDER" value="__PIOS_SMS_SENDER__"/>
  <env name="PIOS_OTP_RELAY_KEY" value="__PIOS_OTP_RELAY_KEY__"/>
  <env name="PIOS_SMS_API_BASE_URL" value="__PIOS_SMS_API_BASE_URL__"/>
  <env name="PIOS_SMS_CONNECT_TIMEOUT_MS" value="__PIOS_SMS_CONNECT_TIMEOUT_MS__"/>
  <env name="PIOS_SMS_READ_TIMEOUT_MS" value="__PIOS_SMS_READ_TIMEOUT_MS__"/>
  <log mode="none"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <onfailure action="restart" delay="120 sec"/>
  <resetfailure>24 hours</resetfailure>
  <startmode>Automatic</startmode>
</service>
