<service>
  <id>pios-frontend</id>
  <name>PIOS Frontend</name>
  <description>PIOS frontend, served from the production build via `vite preview`. T-2 of ENGINEERING_EXECUTION_PLAN_SPRINT_1_PLATFORM_OPERATIONS_MVP.md; grounded in ADR-049 Decisions 1-2. Runs `node.exe` directly against Vite's own CLI script rather than through npm.cmd, so WinSW's stop signal reaches the actual Node process instead of an intermediate cmd shell.</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>node_modules\vite\bin\vite.js preview --host 0.0.0.0 --port 5173</arguments>
  <workingdirectory>C:\Projects\PIOS-Foundation_v1.0\frontend</workingdirectory>
  <!-- The host argument above (0.0.0.0) is not optional: this machine's
       IPv6 loopback is broken, diagnosed earlier this session as a
       third-party VPN/proxy TUN adapter intercepting ::1. Vite's default
       "host: localhost" resolves AAAA first here and binds only to the
       broken IPv6 address, exactly as happened with the plain dev server
       before an explicit host override proved the fix. 0.0.0.0 here, not
       127.0.0.1, is deliberate: O-2 requires phone and LAN reachability,
       not just localhost. -->
  <log mode="none"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <onfailure action="restart" delay="120 sec"/>
  <resetfailure>24 hours</resetfailure>
  <startmode>Automatic</startmode>
</service>
